import /microtrust.rc
import /init.recovery.project.rc

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop sys.usb.ffs.aio_compat 0
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw
    setprop crypto.ready 1

    mkdir /mnt/vendor/persist
    mount ext4 /dev/block/by-name/persist /mnt/vendor/persist

    chmod 0755 /system/bin/load_drivers.sh

# For vibrator - Improvements after initial tests
#    write /sys/class/leds/vibrator/trigger "transient"
#    chown system system /sys/class/leds/vibrator/trigger
#    chown system system /sys/class/leds/vibrator/activate
#    chown system system /sys/class/leds/vibrator/brightness
#    chown system system /sys/class/leds/vibrator/duration
#    chown system system /sys/class/leds/vibrator/state

# We need vold early for metadata encryption
on early-fs
    start vold

on fs
    install_keyring
    wait /dev/block/platform/soc/11270000.ufshci
    symlink /dev/block/platform/soc/11270000.ufshci /dev/block/bootdevice

# When filesystem is mounted and ro.debuggable is 0, configure USB charging mode and start adbd
on fs && property:ro.debuggable=0
    # distinguish USB shoulde connect or not, i.e. CDP vs SDP
    write /sys/class/udc/musb-hdrc/device/cmode 2
    # set charging free due to it wait for USB activation
    start adbd

on post-fs
    start vendor.boot-hal-1-2
    exec u:r:update_engine:s0 root root -- /system/bin/mtk_plpath_utils

on late-fs
    # Mount RW partitions which need run fsck
    mount_all /first_stage_ramdisk/fstab.mt6789 --late

# Service to load vendor DLKM modules using a shell script
service load_vendor_dlkm_modules /system/bin/load_drivers.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

# When recovery service is running, start the vendor DLKM module loading service
on property:init.svc.recovery=running
    start load_vendor_dlkm_modules


service vendor.gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    interface android.hardware.gatekeeper@1.0::IGatekeeper default
    class hal
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/sbin
    disabled
    seclabel u:r:recovery:s0

service vendor.keymint-default /vendor/bin/hw/android.hardware.security.keymint-service
    class early_hal
    user nobody
    interface android.hardware.keymaster@4.0::IKeymasterDevice default
    interface android.hardware.keymaster@4.1::IKeymasterDevice default
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/sbin
    disabled
    seclabel u:r:recovery:s0

on property:ro.crypto.state=encrypted && property:ro.crypto.type=file
    write /proc/bootprof "crypto: install_keyring (crypto.ready=1)"
    setprop crypto.ready 1

on property:crypto.ready=1
    write /proc/bootprof "crypto: start vendor.keymint"
    start vendor.keymint-default

on property:hwservicemanager.ready=true
    start vendor.keymint-default
    start vendor.gatekeeper-1-0

on property:vendor.sys.listener.registered=true
    start vendor.gatekeeper-1-0
    start vendor.keymint-default

on property:ro.crypto.state=unsupported
    stop teei_daemon
    stop vendor.keymint-default
    stop vendor.gatekeeper-1-0

on property:ro.crypto.state=unencrypted
    stop teei_daemon
    stop vendor.keymint-default
    stop vendor.gatekeeper-1-0

on property:twrp.decrypt.done=true && twrp.all.users.decrypted=true
    stop teei_daemon
    stop vendor.keymint-default
    stop vendor.gatekeeper-1-0

on property:crypto.ready=0
    stop teei_daemon
    stop vendor.keymint-default
    stop vendor.gatekeeper-1-0

on boot
    start health-hal-2-1
    setprop sys.usb.config adb

#    start vendor.vibrator-default

#service vendor.vibrator-default /vendor/bin/hw/android.hardware.vibrator-service.mediatek
#    class hal
#    user root
#    group root system
#    seclabel u:r:recovery:s0
